@startuml MamaganWebApp_UseCaseDiagram

title Mamagan Web Application – Use Case Diagram

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  ArrowColor #1E40AF
}

actor "Guest / Tourist" as Guest
actor "Resort Staff / Admin" as Staff
actor "PayMongo Payment Gateway" as PayMongo
actor "System Administrator" as SysAdmin

rectangle "Mamagan Web App" {

  package "Authentication" {
    usecase "Register" as UC_Register
    usecase "Login" as UC_Login
    usecase "Continue with Google" as UC_Google
    usecase "Continue with GitHub" as UC_GitHub
    usecase "View My Bookings" as UC_ViewMyBookings
    usecase "Logout" as UC_Logout
  }

  package "Facility Management" {
    usecase "Browse Facilities" as UC_BrowseFacilities
    usecase "Check Availability" as UC_CheckAvailability
    usecase "Manage Facilities" as UC_ManageFacilities
  }

  package "Booking" {
    usecase "Create Booking" as UC_CreateBooking
    usecase "Cancel Booking" as UC_CancelBooking
    usecase "Confirm Guest Arrival" as UC_ConfirmGuestArrival
  }

  package "Payments" {
    usecase "Pay with GCash/Maya/Card" as UC_PayGCashMayaCard
    usecase "Process Payment via PayMongo" as UC_ProcessViaPayMongo
    usecase "Receive QR Ticket" as UC_ReceiveQRTicket
    usecase "Refund Process" as UC_RefundProcess
  }

  package "Admin Operations" {
    usecase "Manage Bookings" as UC_ManageBookings
    usecase "Manage Rates and Promos" as UC_ManageRatesPromos
    usecase "Manage Blackout Dates" as UC_ManageBlackoutDates
    usecase "Generate Reports" as UC_GenerateReports
  }

}

' ---------------- Relationships (include/extend) ----------------

Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_Google
Guest --> UC_GitHub
Guest --> UC_BrowseFacilities
Guest --> UC_CreateBooking
Guest --> UC_ViewMyBookings
Guest --> UC_Logout

Staff --> UC_ManageFacilities
Staff --> UC_ManageBookings
Staff --> UC_ManageRatesPromos
Staff --> UC_ManageBlackoutDates
Staff --> UC_ConfirmGuestArrival
Staff --> UC_GenerateReports

SysAdmin --> UC_ManageFacilities
SysAdmin --> UC_GenerateReports

' Create Booking composition
UC_CreateBooking .> UC_CheckAvailability : <<include>>
UC_CreateBooking .> UC_PayGCashMayaCard : <<include>>

' Payment composition
UC_PayGCashMayaCard .> UC_ProcessViaPayMongo : <<include>>

' Success flow
UC_ProcessViaPayMongo .> UC_ReceiveQRTicket : <<include>>

' Cancel flow
UC_CancelBooking .> UC_RefundProcess : <<extend>>

' ---------------- Booking/admin admin relationships ----------------
UC_ManageBookings .> UC_CancelBooking : <<include>>

@enduml

