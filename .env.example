# --- Runtime mode ---
NODE_ENV=production
PORT=10000

# App base URLs (used for redirect safety)
SERVER_URL=https://YOUR-RENDER-APP.onrender.com
CLIENT_URL=https://YOUR-RENDER-APP.onrender.com

# --- Auth secrets (set real values in Render, never commit secrets) ---
JWT_SECRET=YOUR_JWT_SECRET_HERE
SESSION_SECRET=YOUR_SESSION_SECRET_HERE

# --- MySQL (Aiven) ---
MYSQL_HOST=YOUR_AIVEN_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_USER=YOUR_AIVEN_MYSQL_USER
MYSQL_PASSWORD=YOUR_AIVEN_MYSQL_PASSWORD
MYSQL_DATABASE=YOUR_AIVEN_MYSQL_DATABASE

# For Aiven/MySQL SSL CA.
# Paste the CA as a single-line string OR keep the \\n line breaks in your env.
MYSQL_SSL_CA=-----BEGIN CERTIFICATE-----\nYOUR_CA_CONTENT\n-----END CERTIFICATE-----

# --- Admin bootstrap account ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# --- Google OAuth ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://YOUR-RENDER-APP.onrender.com/api/auth/google/callback

OAUTH_SUCCESS_GUEST_REDIRECT=/facilities.html
OAUTH_SUCCESS_ADMIN_REDIRECT=/admin/dashboard.html
OAUTH_FAILURE_REDIRECT=/login.html?error=oauth_failed

# --- PayMongo ---
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
MOCK_PAYMENTS=true
