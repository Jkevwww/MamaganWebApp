# --- Runtime mode ---
NODE_ENV=development
PORT=10000

# App base URLs (used for CORS and redirect safety)
SERVER_URL=http://localhost:10000
CLIENT_URL=http://localhost:10000

# --- Auth secrets (set real values locally and in Render; never commit secrets) ---
JWT_SECRET=
SESSION_SECRET=

# --- MySQL (Aiven) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# For Aiven/MySQL SSL CA.
# Paste the CA as a single-line string OR keep the \\n line breaks in your env.
MYSQL_SSL_CA=

# --- Admin bootstrap account (used by seed script) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# --- Google OAuth (Web application client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:10000/api/auth/google/callback

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:10000/api/auth/github/callback

# Post-login redirects (must be same-site paths starting with /)
OAUTH_SUCCESS_GUEST_REDIRECT=/facilities.html
OAUTH_SUCCESS_ADMIN_REDIRECT=/admin/dashboard.html
OAUTH_FAILURE_REDIRECT=/login.html?error=oauth_failed

# Optional: comma-separated origins if you need more than CLIENT_URL
# CORS_ORIGIN=http://localhost:10000

# --- PayMongo ---
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
MOCK_PAYMENTS=true
