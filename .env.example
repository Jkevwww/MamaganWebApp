# Copy this file to .env and fill in real values.
# IMPORTANT: Never commit .env (root/.gitignore already ignores it).

# Server
PORT=3001
NODE_ENV=development

# MySQL (Aiven)
MYSQL_HOST=mamagan-booking-mysql-jeromekevinf-1c6c.a.aivencloud.com
MYSQL_PORT=10302
MYSQL_DATABASE=MamaganBeachdb
MYSQL_USER=Kevin
MYSQL_PASSWORD=
# If your provider requires SSL, set this to the CA certificate.
# For some platforms, you may need to paste the full PEM string.
# Example placeholder:
MYSQL_SSL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cookie / Sessions (if used elsewhere in the app)
SESSION_SECRET=

# OAuth (optional - only used if implemented in this codebase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# PayMongo (optional)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMS (optional)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# URLs (optional)
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001

